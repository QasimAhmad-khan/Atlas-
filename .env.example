DATABASE_URL=postgresql+asyncpg://atlaspipe:atlaspipe@localhost:5432/atlaspipe
TEST_DATABASE_URL=postgresql+asyncpg://atlaspipe:atlaspipe@localhost:5432/atlaspipe_test
MAX_CONCURRENCY=10
PER_DOMAIN_CONCURRENCY=2
REQUESTS_PER_SECOND=5
REQUEST_TIMEOUT=10
MAX_RETRIES=3
BATCH_SIZE=100
FRONTIER_LEASE_SECONDS=60
FRONTIER_POLL_INTERVAL_SECONDS=1
ALLOW_PRIVATE_NETWORKS=false
MAX_RESPONSE_BYTES=1048576
USER_AGENT=AtlasPipe/0.1 (+https://example.invalid/atlaspipe)
LOG_LEVEL=INFO
API_KEY=
API_READ_KEY=
METRICS_KEY=
API_REQUESTS_PER_MINUTE=30
API_URLS_PER_MINUTE=1000
API_MAX_BODY_BYTES=65536
ENVIRONMENT=local
RELEASE=development
